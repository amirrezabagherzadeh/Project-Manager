# Runtime mode: development, test, or production
APP_ENVIRONMENT=development

# Documentation is available only when this is true and the environment is not production.
APP_DOCS_ENABLED=true

# Comma-separated JSON list of explicitly allowed browser origins.
APP_CORS_ORIGINS=["http://localhost:3000"]
APP_TRUSTED_ORIGINS=["http://localhost:3000"]

# SQLite MVP database. PostgreSQL-compatible deployments replace this URL.
APP_DATABASE_URL=sqlite+aiosqlite:///./storage/app.db

# Required in production (32+ unique characters). Never commit a real value.
APP_SECRET_KEY=

# Access JWT and refresh-session lifetimes.
APP_ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_REFRESH_TOKEN_EXPIRE_DAYS=7

# Refresh cookie. Production requires Secure=true.
APP_REFRESH_COOKIE_NAME=ppm_refresh
APP_REFRESH_COOKIE_PATH=/api/v1/auth
APP_REFRESH_COOKIE_SECURE=false
APP_REFRESH_COOKIE_SAMESITE=lax

# Independent single-process MVP rate limits.
APP_REGISTER_RATE_LIMIT_REQUESTS=5
APP_REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
APP_LOGIN_RATE_LIMIT_REQUESTS=10
APP_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
